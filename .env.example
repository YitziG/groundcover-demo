# Copy to .env and fill in. .env is gitignored.
#
# GROUNDCOVER_SITE is the ingestion endpoint from Settings -> Access -> Ingestion Keys.
# That tab is empty until a BYOC backend exists in your own AWS, GCP, or Azure account.
# Signup alone does not create one. See the README.
# https://docs.groundcover.com/getting-started/installation-and-updating/connect-kubernetes-cluster
GROUNDCOVER_SITE=

# Optional. The CLI detects the cluster name when clusterId is omitted.
# This demo sets both so the cluster is easy to find in the Cluster Picker.
GROUNDCOVER_CLUSTER_ID=pebble
GROUNDCOVER_ENV=dev

# Optional sensor ingestion key. Leave empty to let `groundcover deploy`
# use an existing key or provision one. Set it if you want the Helm-style
# global.groundcover_token value written into the generated values file.
# Create a key of type Sensor. Treat it like a password.
# https://docs.groundcover.com/collect-data/ingestion-keys
GROUNDCOVER_TOKEN=
